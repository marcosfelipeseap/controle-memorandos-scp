<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Cadastro - Controle de Memorandos</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light d-flex align-items-center justify-content-center vh-100">
  <div class="card shadow p-4" style="width: 100%; max-width: 400px;">
    <h3 class="fw-bold mb-3 text-center">Criar Nova Conta</h3>
    
    <% if (erro) { %>
      <div class="alert alert-danger py-2"><%= erro %></div>
    <% } %>

    <form action="/cadastro" method="POST">
      <div class="mb-3">
        <label class="form-label fw-bold">Nome Completo</label>
        <input type="text" name="nome" class="form-control" required>
      </div>
      <div class="mb-3">
        <label class="form-label fw-bold">Nome de Usuário (Username)</label>
        <input type="text" name="username" class="form-control" required placeholder="Ex: joao.silva">
      </div>
      <div class="mb-3">
        <label class="form-label fw-bold">Senha</label>
        <input type="password" name="senha" class="form-control" required>
      </div>
      <button type="submit" class="btn btn-dark w-100 mb-3">Solicitar Cadastro</button>
      <div class="text-center">
        <a href="/login" class="text-decoration-none">Já tem uma conta? Faça login</a>
      </div>
    </form>
  </div>
</body>
</html>