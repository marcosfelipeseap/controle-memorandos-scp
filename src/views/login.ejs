<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Login - Controle de Memorandos</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light d-flex align-items-center justify-content-center vh-100">
  <div class="card shadow p-4" style="width: 100%; max-width: 400px;">
    <h3 class="fw-bold mb-3 text-center">Entrar no Sistema</h3>
    
    <% if (erro) { %>
      <div class="alert alert-danger py-2"><%= erro %></div>
    <% } %>
    <% if (sucesso) { %>
      <div class="alert alert-success py-2"><%= sucesso %></div>
    <% } %>

    <form action="/login" method="POST">
      <div class="mb-3">
        <label class="form-label fw-bold">Nome de Usuário</label>
        <input type="text" name="username" class="form-control" required autocomplete="username">
      </div>
      <div class="mb-3">
        <label class="form-label fw-bold">Senha</label>
        <input type="password" name="senha" class="form-control" required autocomplete="current-password">
      </div>
      <button type="submit" class="btn btn-primary w-100 mb-3">Entrar</button>
      <div class="text-center">
        <a href="/cadastro" class="text-decoration-none">Não tem uma conta? Cadastre-se</a>
      </div>
    </form>
  </div>
</body>
</html>