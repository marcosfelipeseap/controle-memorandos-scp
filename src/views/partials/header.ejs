<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SCP - Controle de Memorandos</title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
  <!-- Estilos Customizados -->
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>

  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container-fluid px-4">
      <a class="navbar-brand d-flex align-items-center gap-2" href="/">
        <i class="bi bi-folder2-open text-primary fs-4"></i>
        <span>SCP <small class="text-muted fw-normal fs-6">| Controle de Memorandos</small></span>
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse justify-content-between" id="navbarNav">
        <!-- Links Principais -->
        <ul class="navbar-nav gap-2">
          <li class="nav-item">
            <a class="nav-link px-3 rounded <%= locals.abaAtiva === 'expedidos' ? 'active bg-primary text-white' : 'text-light' %>" href="/expedidos">
              <i class="bi bi-box-arrow-up-right me-1"></i> Expedidos
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link px-3 rounded <%= locals.abaAtiva === 'recebidos' ? 'active bg-primary text-white' : 'text-light' %>" href="/recebidos">
              <i class="bi bi-box-arrow-in-down me-1"></i> Recebidos
            </a>
          </li>
          
          <% if (locals.usuarioLogado && locals.usuarioLogado.role === 'admin') { %>
            <li class="nav-item">
              <a class="nav-link px-3 rounded <%= locals.abaAtiva === 'usuarios' ? 'active bg-primary text-white' : 'text-light' %>" href="/admin/usuarios">
                <i class="bi bi-people me-1"></i> Gerenciar Usuários
              </a>
            </li>
          <% } %>
        </ul>

        <!-- Perfil e Logout -->
        <ul class="navbar-nav align-items-center gap-3">
          <% if (locals.usuarioLogado) { %>
            <li class="nav-item text-light small d-none d-lg-block">
              <i class="bi bi-person-circle text-primary me-1"></i> 
              Olá, <strong class="text-white"><%= locals.usuarioLogado.nome %></strong> 
              <span class="badge bg-secondary ms-1 text-uppercase"><%= locals.usuarioLogado.role %></span>
            </li>
            <li class="nav-item">
              <a href="/logout" class="btn btn-outline-danger btn-sm px-3">
                <i class="bi bi-box-arrow-right me-1"></i> Sair
              </a>
            </li>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Main Container -->
  <main class="container-fluid px-4 py-4">

    <% if (locals.sucesso) { %>
      <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> <%= sucesso %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <% if (locals.erro) { %>
      <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= erro %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>